{
  "name": "@ducsigr/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "postinstall": "test -d prisma/schema && npx prisma generate --schema prisma/schema || echo 'Skipping prisma generate (schema not found)'",
    "db:generate": "npx prisma generate --schema prisma/schema",
    "db:push": "npx prisma db push --schema prisma/schema",
    "db:migrate": "npx prisma migrate dev --schema prisma/schema",
    "db:migrate:deploy": "npx prisma migrate deploy --schema prisma/schema",
    "db:studio": "npx prisma studio --schema prisma/schema",
    "db:seed": "tsx seeding/index.ts",
    "db:seed-sessions": "tsx src/seed-sessions.ts",
    "db:seed-alerts": "tsx src/seed-alert-history.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/client-runtime-utils": "^7.0.0",
    "dotenv": "^16.4.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@ducsigr/config-eslint": "workspace:*",
    "@ducsigr/config-typescript": "workspace:*",
    "@eslint/js": "^9.16.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.16.0",
    "prisma": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
