// ============================================================
// Knowledge Base Models
// ============================================================

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeEntityType {
  PROJECT
  TRACE
  SPAN
  ALERT
  ALERT_HISTORY
}

enum KnowledgeRuleScope {
  WORKSPACE
  PROJECT
}

enum RuleMatchType {
  DIRECT_LINK
  RULE
  SEMANTIC
}

enum ChunkSourceType {
  ARTICLE
  ATTACHMENT
}

// ============================================================
// KnowledgeGroup - Hierarchical folders for organizing articles
// ============================================================

model KnowledgeGroup {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    KnowledgeGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeGroup[] @relation("GroupHierarchy")
  articles  KnowledgeArticle[]
  rules     KnowledgeRule[]  @relation("RuleTargetGroup")

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId])
  @@index([parentId])
  @@index([workspaceId, sortOrder])
}

// ============================================================
// KnowledgeArticle - Main KB content (markdown)
// ============================================================

model KnowledgeArticle {
  id          String        @id @default(cuid())
  workspaceId String
  groupId     String?
  title       String
  slug        String
  summary     String?       @db.Text
  content     String        @db.Text
  tags        String[]      @default([])
  status      ArticleStatus @default(DRAFT)
  searchText  String?       @db.Text

  // Audit
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Metrics
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group       KnowledgeGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User?                     @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?                     @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions    KnowledgeArticleVersion[]
  chunks      KnowledgeChunk[]
  links       KnowledgeLink[]
  attachments KnowledgeAttachment[]
  rules       KnowledgeRule[]           @relation("RuleTargetArticle")
  rcaMatches  AlertRCAKnowledge[]
  evalSuites  EvalSuiteKnowledge[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([groupId])
  @@index([workspaceId, status, updatedAt(sort: Desc)])
}

// ============================================================
// KnowledgeArticleVersion - Version history with diffs
// ============================================================

model KnowledgeArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  version   Int
  title     String
  summary   String?  @db.Text
  content   String   @db.Text
  tags      String[] @default([])
  diff      String?  @db.Text // JSON diff from previous version
  checksum  String // SHA-256 of content for deduplication

  createdById String?
  createdAt   DateTime @default(now())

  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("ArticleVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([articleId, version])
  @@index([articleId, createdAt(sort: Desc)])
  @@index([checksum])
}

// ============================================================
// KnowledgeRule - Auto-association rules for RCA and traces
// ============================================================

model KnowledgeRule {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean            @default(true)
  priority    Int                @default(0) // Higher = higher priority

  // Scope
  scope     KnowledgeRuleScope @default(WORKSPACE)
  projectId String? // Only set if scope = PROJECT

  // Condition: FilterExpression DSL (JSON)
  condition Json

  // Target: Either article or group (exactly one should be set)
  articleId String?
  groupId   String?

  // Match reason template (supports {{variable}} placeholders)
  matchReasonTemplate String?

  // Metrics
  matchCount    Int       @default(0)
  lastMatchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  article   KnowledgeArticle? @relation("RuleTargetArticle", fields: [articleId], references: [id], onDelete: Cascade)
  group     KnowledgeGroup?   @relation("RuleTargetGroup", fields: [groupId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@index([workspaceId, priority(sort: Desc)])
  @@index([projectId])
}

// ============================================================
// KnowledgeLink - Explicit connections to entities
// ============================================================

model KnowledgeLink {
  id          String              @id @default(cuid())
  workspaceId String
  articleId   String
  entityType  KnowledgeEntityType
  entityId    String
  note        String?             @db.Text

  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("LinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([articleId, entityType, entityId])
  @@index([workspaceId])
  @@index([articleId])
  @@index([entityType, entityId])
}

// ============================================================
// KnowledgeAttachment - File attachments
// ============================================================

model KnowledgeAttachment {
  id            String  @id @default(cuid())
  workspaceId   String
  articleId     String
  fileName      String
  contentType   String
  sizeBytes     Int
  storageKey    String // S3/R2 object key
  extractedText String? @db.Text // Text extracted from PDFs/images

  createdAt DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([workspaceId])
}

// ============================================================
// KnowledgeChunk - Text slices for semantic search
// ============================================================

model KnowledgeChunk {
  id          String          @id @default(cuid())
  articleId   String
  workspaceId String
  sourceType  ChunkSourceType @default(ARTICLE)
  sourceId    String? // attachmentId if sourceType = ATTACHMENT

  content      String @db.Text
  contentHash  String // SHA-256 for deduplication
  startOffset  Int
  endOffset    Int
  sectionTitle String? // Heading context for display

  // Embedding stored as pgvector (1536 floats for OpenAI text-embedding-3-small)
  // Managed via raw SQL in packages/db/src/vector.ts
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([workspaceId])
  @@index([contentHash])
  @@index([sourceType, sourceId])
}

// ============================================================
// AlertRCAKnowledge - Join table for RCA snapshots
// ============================================================

model AlertRCAKnowledge {
  id        String        @id @default(cuid())
  rcaId     String
  articleId String
  matchType RuleMatchType
  matchScore Float? // Semantic similarity score (0-1)
  matchReason String?

  // Snapshot at time of RCA (in case article changes later)
  snapshotTitle   String
  snapshotExcerpt String? @db.Text

  createdAt DateTime @default(now())

  rca     AlertRCA         @relation(fields: [rcaId], references: [id], onDelete: Cascade)
  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([rcaId, articleId])
  @@index([rcaId])
  @@index([articleId])
}
