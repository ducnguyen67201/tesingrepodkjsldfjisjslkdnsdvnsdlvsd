// ============================================================
// Tracking Models (Sessions & User Tracking)
// ============================================================

model TrackedUser {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId  String   // User's ID from their system (required)
  name        String?  // Display name
  email       String?  // User email (for lookup)
  metadata    Json?    // Custom attributes (plan, company, etc.)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions TraceSession[]
  // Note: Trace relation removed - user info now in OTLP resource attributes

  @@unique([projectId, externalId])
  @@index([projectId, lastSeenAt(sort: Desc)])
  @@index([projectId, email])
}

model TraceSession {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId String?      // User-provided session ID
  userId     String?      // Link to TrackedUser
  user       TrackedUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String?      // Optional display name
  metadata   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Note: Trace relation removed - session info now in OTLP resource attributes

  @@unique([projectId, externalId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
}
