// ============================================================
// OTLP-First Trace Model
// ============================================================

model Trace {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalTraceId String   // Hex trace ID from OTLP (32-char hex)

  // Resource attributes (promoted for filtering)
  serviceName     String   // resource.service.name (required)
  serviceVersion  String?  // resource.service.version
  environment     String?  // resource.deployment.environment
  resource        Json?    // Full OTLP resource attributes JSON

  // Timing
  startTime       DateTime // Earliest span startTime
  endTime         DateTime? // Latest span endTime
  durationMs      Int?     // Computed: endTime - startTime

  // Aggregates (denormalized for query performance)
  spanCount       Int      @default(0)
  errorCount      Int      @default(0)

  // ============================================================
  // V2: Root Span Metadata (promoted for filtering)
  // ============================================================
  rootSpanId          String?   // externalSpanId of root span
  rootSpanName        String?   // name of root span (e.g., "POST /api/users")
  rootSpanKind        String?   // kind of root span (SERVER, CLIENT, etc.)
  rootSpanStatusCode  String?   // statusCode of root span (UNSET, OK, ERROR)
  rootSpanDurationMs  Int?      // durationMs of root span

  // ============================================================
  // V2: Error/Exception Flags
  // ============================================================
  hasError            Boolean   @default(false)  // Any span with statusCode=ERROR
  hasException        Boolean   @default(false)  // Any span with exception event

  // ============================================================
  // V2: Span Type Aggregation
  // ============================================================
  spanTypes           String[]  @default([])     // ["LLM", "HTTP", "DB", etc.]

  // ============================================================
  // V2: Full-Text Search
  // ============================================================
  searchText          String?                    // Denormalized text for FTS

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  spans Span[]

  @@unique([projectId, externalTraceId])
  @@index([projectId, startTime(sort: Desc)])
  @@index([projectId, serviceName])
  @@index([projectId, environment])
  @@index([projectId, durationMs])
  @@index([startTime])

  // V2: New Indexes for filtering
  @@index([projectId, hasError])
  @@index([projectId, hasException])
  @@index([projectId, rootSpanName])
  @@index([projectId, rootSpanStatusCode])
}

// ============================================================
// OTLP-First Span Model
// ============================================================

model Span {
  id               String   @id @default(cuid())
  traceId          String
  trace            Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  externalSpanId   String   // Hex span ID from OTLP (16-char hex)
  parentSpanId     String?  // Hex parent span ID (external reference)

  // Core OTLP fields
  name             String   // Span name/operation
  kind             String   @default("INTERNAL") // INTERNAL | SERVER | CLIENT | PRODUCER | CONSUMER
  statusCode       String   @default("UNSET")    // UNSET | OK | ERROR
  statusMessage    String?  // Status description (for errors)
  traceState       String?  // W3C trace state

  // Timing
  startTime        DateTime
  endTime          DateTime?
  durationMs       Int?     // Computed: endTime - startTime

  // OTLP data (stored as JSON)
  attributes       Json?    // Span attributes key-value pairs
  events           Json?    // Span events array [{timeUnixNano, name, attributes}]
  links            Json?    // Span links array [{traceId, spanId, attributes}]

  // Instrumentation scope
  libraryName      String?  // scope.name (e.g., "@opentelemetry/instrumentation-openai")
  libraryVersion   String?  // scope.version

  // GenAI fields (promoted from gen_ai.* attributes for query performance)
  model            String?  // gen_ai.request.model
  modelParameters  Json?    // gen_ai.request.* parameters
  input            Json?    // gen_ai.prompt or gen_ai.request.messages
  output           Json?    // gen_ai.completion or gen_ai.response
  promptTokens     Int?     // gen_ai.usage.prompt_tokens
  completionTokens Int?     // gen_ai.usage.completion_tokens
  totalTokens      Int?     // gen_ai.usage.total_tokens

  // Cost tracking (computed server-side)
  inputCost        Decimal?      @db.Decimal(10, 6)
  outputCost       Decimal?      @db.Decimal(10, 6)
  totalCost        Decimal?      @db.Decimal(10, 6)
  pricingId        String?
  pricing          ModelPricing? @relation(fields: [pricingId], references: [id])

  // ============================================================
  // V2: HTTP Semantic Conventions
  // ============================================================
  httpMethod          String?   // http.request.method OR http.method
  httpRoute           String?   // http.route
  httpStatusCode      Int?      // http.response.status_code
  httpUrl             String?   // url.full OR http.url (truncated to 2048)

  // ============================================================
  // V2: Database Semantic Conventions
  // ============================================================
  dbSystem            String?   // db.system (e.g., "postgresql", "mysql", "redis")
  dbName              String?   // db.name
  dbOperation         String?   // db.operation (e.g., "SELECT", "INSERT")
  dbStatement         String?   // db.statement (truncated to 4096)
  dbCollection        String?   // db.collection.name (for NoSQL)

  // ============================================================
  // V2: RPC Semantic Conventions
  // ============================================================
  rpcSystem           String?   // rpc.system (e.g., "grpc", "aws-api")
  rpcService          String?   // rpc.service
  rpcMethod           String?   // rpc.method
  rpcStatusCode       Int?      // rpc.grpc.status_code

  // ============================================================
  // V2: Exception Semantic Conventions
  // ============================================================
  exceptionType       String?   // exception.type (extracted from events)
  exceptionMessage    String?   // exception.message (truncated to 1024)

  // ============================================================
  // V2: GenAI Additional Fields
  // ============================================================
  genAiOperation      String?   // gen_ai.operation.name (e.g., "chat", "embeddings")
  genAiProvider       String?   // gen_ai.provider.name (e.g., "openai", "anthropic")

  // ============================================================
  // V2: Inferred Span Type
  // ============================================================
  spanType            String?   // Inferred type: LLM, HTTP, DB, RPC, FUNCTION, CUSTOM

  // ============================================================
  // V2: Full-Text Search
  // ============================================================
  searchText          String?   // Denormalized text for FTS

  // ============================================================
  // Prompt Experiment Tracking
  // ============================================================
  promptExperimentId   String?
  promptExperimentSlug String?
  promptVariantId      String?
  promptVariantName    String?  // "A" | "B"
  assignmentKeyHash    String?  // SHA-256 hash (never store raw)

  // Audit
  createdAt        DateTime @default(now())

  @@unique([traceId, externalSpanId])
  @@index([traceId, startTime])
  @@index([traceId])
  @@index([parentSpanId])
  @@index([startTime])
  @@index([statusCode])
  @@index([model])
  @@index([pricingId])

  // V2: New Indexes for filtering
  @@index([traceId, spanType])
  @@index([httpStatusCode])
  @@index([httpRoute])
  @@index([dbSystem])
  @@index([rpcSystem])
  @@index([exceptionType])
  @@index([genAiOperation])
  @@index([genAiProvider])
}
