// ============================================================
// Eval Pipeline Models (Regression Detection)
// ============================================================

enum EvalRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  REGRESSION_DETECTED
}

model EvalSuite {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean  @default(true)
  endpoint    String   // API endpoint to test
  prompts     Json     // Array of test prompts
  expectedBehaviors Json // Expected behaviors/assertions

  // Baseline metrics for comparison
  baselineLatencyP95 Float?
  baselineErrorRate  Float?
  baselineScores     Json?

  // Regression thresholds (multipliers)
  latencyRegressionThreshold Float @default(1.2) // 20% slower = regression
  errorRegressionThreshold   Float @default(2.0) // 2x errors = regression

  runs        EvalRun[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional knowledge base articles for context
  knowledgeArticles EvalSuiteKnowledge[]

  @@index([projectId])
}

/// Join table for EvalSuite <-> KnowledgeArticle (optional KB context for evals)
model EvalSuiteKnowledge {
  id        String @id @default(cuid())
  suiteId   String
  suite     EvalSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([suiteId, articleId])
  @@index([suiteId])
  @@index([articleId])
}

model EvalRun {
  id            String        @id @default(cuid())
  suiteId       String
  suite         EvalSuite     @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  triggeredBy   String        // "pr_merge" | "manual" | "scheduled"
  triggerRef    String?       // PR number or commit SHA
  status        EvalRunStatus @default(PENDING)
  startedAt     DateTime?
  completedAt   DateTime?

  // Test results
  totalPrompts  Int
  passedPrompts Int?
  failedPrompts Int?

  // Metrics
  latencyP95    Float?
  errorRate     Float?
  scores        Json?

  // Regression detection
  isRegression      Boolean?
  regressionDetails Json?     // Details about what regressed

  createdAt     DateTime @default(now())

  @@index([suiteId, createdAt(sort: Desc)])
}
