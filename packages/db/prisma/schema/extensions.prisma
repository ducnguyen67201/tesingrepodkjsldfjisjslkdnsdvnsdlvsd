// ============================================================
// Extensions Hub Models
// ============================================================

// Extension types - source of truth
enum ExtensionType {
  THEME
  INGESTION
  POLICY
  WEBHOOK
}

// Visibility for catalog
enum ExtensionVisibility {
  PUBLIC // Available to all workspaces
  PRIVATE // Only owner workspace
  UNLISTED // Available by direct link
}

// Extension catalog entry (global)
model Extension {
  id          String              @id @default(cuid())
  slug        String              @unique // e.g., "com.acme.scrub-plus"
  name        String
  description String?
  type        ExtensionType
  visibility  ExtensionVisibility @default(PRIVATE)
  ownerId     String // User who created
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  owner    User               @relation("ExtensionOwner", fields: [ownerId], references: [id])
  versions ExtensionVersion[]
  installs ExtensionInstall[]

  @@index([type])
  @@index([visibility])
  @@index([ownerId])
}

// Immutable version with manifest
model ExtensionVersion {
  id          String   @id @default(cuid())
  extensionId String
  version     String // semver: "1.0.0"
  manifest    Json // Full manifest JSON
  entry       String? // Entry point (dist/index.js)
  changelog   String?
  deprecated  Boolean  @default(false)
  createdAt   DateTime @default(now())

  extension Extension          @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  installs  ExtensionInstall[]

  @@unique([extensionId, version])
  @@index([extensionId])
}

// Workspace installation
model ExtensionInstall {
  id                  String   @id @default(cuid())
  workspaceId         String
  extensionId         String
  extensionVersionId  String
  enabled             Boolean  @default(true)
  configJson          Json? // Workspace-specific config
  approvedPermissions String[] // Permissions approved at install
  installedById       String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extension   Extension            @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version     ExtensionVersion     @relation(fields: [extensionVersionId], references: [id])
  installedBy User                 @relation("ExtensionInstalledBy", fields: [installedById], references: [id])
  auditLogs   ExtensionAuditLog[]

  @@unique([workspaceId, extensionId]) // One install per extension per workspace
  @@index([workspaceId])
  @@index([extensionId])
  @@index([enabled])
}

// Audit trail
model ExtensionAuditLog {
  id        String   @id @default(cuid())
  installId String
  action    String // INSTALLED, ENABLED, DISABLED, CONFIGURED, UNINSTALLED, UPDATED
  actorId   String
  metadata  Json? // Action-specific data
  createdAt DateTime @default(now())

  install ExtensionInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  actor   User             @relation("ExtensionAuditActor", fields: [actorId], references: [id])

  @@index([installId])
  @@index([actorId])
  @@index([createdAt])
}
