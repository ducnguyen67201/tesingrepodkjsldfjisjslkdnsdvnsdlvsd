{
  "name": "@ducsigr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./lib/cost": {
      "types": "./dist/lib/cost/index.d.ts",
      "import": "./dist/lib/cost/index.js"
    },
    "./lib/alerting": {
      "types": "./dist/lib/alerting/index.d.ts",
      "import": "./dist/lib/alerting/index.js"
    },
    "./lib/alerting/init": {
      "types": "./dist/lib/alerting/init.d.ts",
      "import": "./dist/lib/alerting/init.js"
    },
    "./lib/github": {
      "types": "./dist/lib/github/index.d.ts",
      "import": "./dist/lib/github/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ducsigr/db": "workspace:*",
    "@ducsigr/shared": "workspace:*",
    "@temporalio/client": "^1.13.2",
    "@trpc/server": "^11.0.0",
    "date-fns": "^4.1.0",
    "nodemailer": "^6.9.16",
    "superjson": "^2.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@ducsigr/config-eslint": "workspace:*",
    "@ducsigr/config-typescript": "workspace:*",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.16.0",
    "next-auth": "^4.24.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "next-auth": "^4.24.0"
  }
}
