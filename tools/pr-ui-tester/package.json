{
  "name": "@qa/pr-ui-tester",
  "version": "1.0.0",
  "private": true,
  "description": "PR-driven UI regression testing tool",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsx src/index.ts",
    "test:staging": "TEST_MODE=full-staging tsx src/index.ts",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@octokit/rest": "^21.0.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
